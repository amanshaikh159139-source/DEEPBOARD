# Account and game database. Keep sqlite for existing local-only behavior.
# For XAMPP MySQL, import backend/deepboard_mysql.sql in phpMyAdmin and set DB_BACKEND=mysql.
DB_BACKEND=sqlite
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=deepboard_db
MYSQL_USER=root
MYSQL_PASSWORD=

# Optional: leave blank to let DeepBoard create and persist a random local secret.
DEEPBOARD_SECRET_KEY=

# Optional Google Identity Services. Set the same OAuth client ID in
# frontend/js/config.js as CONFIG.GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=

# Optional general-purpose chatbot. Leave blank to use the local chess-help fallback.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional Stockfish override. Leave blank to use the bundled Windows engine
# or `stockfish` available on PATH.
STOCKFISH_PATH=
STOCKFISH_THREADS=4
HOST=127.0.0.1
PORT=5050
